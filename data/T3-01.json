dx:-40px;--dy:540px;--dr:-180deg\" cx=\"360\" cy=\"80\" rx=\"9\" ry=\"6\" fill=\"url(#hsPetG)\"/>\n          <ellipse class=\"hs-petal\" style=\"--t:13.5s;--d:5s;--dx:80px;--dy:560px;--dr:240deg\" cx=\"500\" cy=\"60\" rx=\"10\" ry=\"6.5\" fill=\"url(#hsPetG)\"/>\n          <ellipse class=\"hs-petal\" style=\"--t:17s;--d:7.5s;--dx:-30px;--dy:520px;--dr:-220deg\" cx=\"270\" cy=\"100\" rx=\"8\" ry=\"5.5\" fill=\"url(#hsPetG)\"/>\n          <ellipse class=\"hs-petal\" style=\"--t:14.5s;--d:3.6s;--dx:50px;--dy:560px;--dr:180deg\" cx=\"600\" cy=\"90\" rx=\"9.5\" ry=\"6\" fill=\"url(#hsPetG)\"/>\n        </g>\n\n        <!-- vignette -->\n        <rect x=\"0\" y=\"0\" width=\"1040\" height=\"700\" fill=\"url(#hsVig)\"/>\n      </svg>\n      </div>\n      <figcaption class=\"h-cap\">\n        <div class=\"hk\">Suaramu, sampai padanya</div>\n        <div class=\"hsub\">Menempuh cairan dan dinding, suaramu tiba sebagai riak hangat yang teredam — dan ia mulai mengenalmu.</div>\n      </figcaption>\n    </figure>\n    <div class=\"aud r\" role=\"group\" aria-label=\"Pemutar narasi\">\n      <button class=\"aud-btn\" id=\"audBtn\" aria-label=\"Putar narasi\" aria-pressed=\"false\">\n        <svg id=\"audIcon\" viewBox=\"0 0 24 24\" fill=\"currentColor\" aria-hidden=\"true\"><path id=\"audPath\" d=\"M8 5v14l11-7z\"/></svg>\n      </button>\n      <div class=\"aud-meta\">\n        <div class=\"aud-title\"><span class=\"pre\">Dengarkan</span>Narasi · Suara untuk Ananda</div>\n        <div class=\"aud-bar\" id=\"audBar\"><div class=\"aud-fill\" id=\"audFill\"></div></div>\n      </div>\n      <div class=\"aud-time\" id=\"audTime\">1:42</div>\n      <audio id=\"audEl\" preload=\"metadata\" src=\"audio/narasi/t3-01.mp3\"></audio>\n    </div>\n    <div class=\"scrollcue r\"><span class=\"m\"></span> Gulir perlahan</div>\n  </section>\n\n  <section class=\"beat\">\n    <div class=\"kicker r\">Yang terjadi</div>\n    <h2 class=\"r\">Di minggu-minggu ini, ananda sudah <em class=\"cool\">mendengarmu</em>.</h2>\n    <p class=\"lead r\">Ia bergerak ketika kau bicara, dan detak jantungnya berubah pada suaramu. Setelah lahir, ia akan lebih tenang pada suara serta melodi yang sama.</p>\n  </section>\n\n  <div class=\"scrolly\" id=\"scrolly\">\n    <div class=\"sticky\">\n      <div class=\"stage-title\"><span class=\"kicker\">Bagaimana suara sampai padanya</span></div>\n      <div class=\"stage-wrap\">\n        <div class=\"stage\">\n          <svg viewBox=\"0 0 460 460\" role=\"img\" aria-label=\"Diagram: suara Ibu merambat ke ananda di dalam rahim\">\n            <defs>\n              <radialGradient id=\"wombG\" cx=\"48%\" cy=\"44%\" r=\"62%\"><stop offset=\"0%\" stop-color=\"rgba(248,201,221,.62)\"/><stop offset=\"65%\" stop-color=\"rgba(237,108,182,.14)\"/><stop offset=\"100%\" stop-color=\"rgba(237,108,182,0)\"/></radialGradient>\n              <radialGradient id=\"babyG\" cx=\"42%\" cy=\"38%\" r=\"70%\"><stop offset=\"0%\" stop-color=\"#FBD3E1\"/><stop offset=\"48%\" stop-color=\"#EE8CB6\"/><stop offset=\"100%\" stop-color=\"#D2679A\"/></radialGradient>\n              <radialGradient id=\"wombGlow\" cx=\"46%\" cy=\"42%\" r=\"60%\"><stop offset=\"0%\" stop-color=\"#FFEFC9\" stop-opacity=\".7\"/><stop offset=\"70%\" stop-color=\"#F8CFE0\" stop-opacity=\".12\"/><stop offset=\"100%\" stop-color=\"#F8CFE0\" stop-opacity=\"0\"/></radialGradient>\n            </defs>\n            <path class=\"embrace\" d=\"M95 300 C80 360 140 402 215 402\"/>\n            <path class=\"embrace\" d=\"M335 300 C350 360 290 402 215 402\"/>\n            <g class=\"wombwrap\"><circle class=\"womb\" cx=\"215\" cy=\"238\" r=\"138\"/><circle cx=\"215\" cy=\"234\" r=\"124\" fill=\"url(#wombGlow)\"/></g>\n            <g class=\"babywrap\" id=\"baby\">\n              <g transform=\"translate(216,236) rotate(-14)\">\n                <ellipse class=\"baby\" cx=\"0\" cy=\"8\" rx=\"40\" ry=\"35\"/>\n                <circle class=\"baby\" cx=\"-26\" cy=\"22\" r=\"18\"/>\n                <circle class=\"baby\" cx=\"9\" cy=\"-30\" r=\"20\"/>\n                <ellipse cx=\"0\" cy=\"-34\" rx=\"7\" ry=\"5\" fill=\"#FFFFFF\" fill-opacity=\".34\"/>\n              </g>\n              <path class=\"cord\" d=\"M196 268 C176 286 166 308 160 330\"/>\n            </g>\n            <g class=\"wavewrap\">\n              <circle class=\"ring\" cx=\"96\" cy=\"150\" r=\"80\"/><circle class=\"ring\" cx=\"96\" cy=\"150\" r=\"80\"/>\n              <circle class=\"ring\" cx=\"96\" cy=\"150\" r=\"80\"/><circle class=\"ring\" cx=\"96\" cy=\"150\" r=\"80\"/>\n            </g>\n            <path class=\"mouth\" d=\"M84 150 q12 9 24 0\"/>\n            <line class=\"lead-line\" x1=\"96\" y1=\"78\" x2=\"96\" y2=\"128\"/><circle class=\"dot\" cx=\"96\" cy=\"150\" r=\"2.5\"/>\n            <text class=\"lbl\" x=\"96\" y=\"66\" text-anchor=\"middle\">Suara Ibu</text>\n            <line class=\"lead-line\" x1=\"238\" y1=\"184\" x2=\"358\" y2=\"152\"/>\n            <text class=\"lbl\" x=\"368\" y=\"148\" text-anchor=\"start\">Ananda</text>\n            <text class=\"lbl sm\" x=\"368\" y=\"167\" text-anchor=\"start\">(janin)</text>\n            <line class=\"lead-line\" x1=\"340\" y1=\"288\" x2=\"360\" y2=\"290\"/>\n            <text class=\"lbl sm\" x=\"370\" y=\"294\" text-anchor=\"start\">rahim</text>\n            <line class=\"lead-line\" x1=\"104\" y1=\"388\" x2=\"130\" y2=\"394\"/>\n            <text class=\"lbl sm\" x=\"20\" y=\"392\" text-anchor=\"start\">pelukan Ibu</text>\n          </svg>\n        </div>\n      </div>\n      <p class=\"caption\" id=\"cap\">Pendengaran ananda sudah aktif dan konsisten sejak sekitar minggu ke-28.</p>\n    </div>\n  </div>\n\n  <section class=\"beat\">\n    <div class=\"kicker r\">Pertanyaan yang mungkin muncul</div>\n    <h2 class=\"r\" style=\"margin-bottom:var(--s1)\">Kenapa begitu?</h2>\n    <div class=\"r\">\n      <div class=\"qa\" data-qa>\n        <button aria-expanded=\"false\"><span>Kenapa suara Ibu paling jelas bagi ananda?</span><span class=\"mk\"><svg viewBox=\"0 0 24 24\" width=\"16\" height=\"16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\"><path d=\"M12 5v14M5 12h14\"/></svg></span></button>\n        <div class=\"ans\"><div class=\"ans-in\">Karena dihantar dari dalam tubuh Ibu sendiri — lebih sedikit teredam, dan irama serta nadanya terjaga. <span class=\"src-inline\">Voegtline dkk. (2013)</span></div></div>\n      </div>\n      <div class=\"qa\" data-qa>\n        <button aria-expanded=\"false\"><span>Kenapa memilih murottal, bukan sekadar musik?</span><span class=\"mk\"><svg viewBox=\"0 0 24 24\" width=\"16\" height=\"16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\"><path d=\"M12 5v14M5 12h14\"/></svg></span></button>\n        <div class=\"ans\"><div class=\"ans-in\">Mekanismenya sama — pembiasaan membentuk keakraban. Tetapi maknanya berbeda: keluarga Muslim memilih Al-Qur’an karena nilainya dan untuk memulai ikatan ananda dengannya. Sains menjelaskan “bagaimana”, iman menjelaskan “untuk apa”.</div></div>\n      </div>\n    </div>\n  </section>\n\n  <section class=\"beat\">\n    <div class=\"kicker r\">Maknanya</div>\n    <h2 class=\"r\">Maka kita isi jendela ini dengan yang <em class=\"warm\">paling berharga</em>.</h2>\n    <div class=\"layer iman r\"><div class=\"l\">Makna · Iman</div>Lantunan Al-Qur’an dengan tartil — perlahan dan tertata (Al-Muzzammil 73:4) — bersama suara penuh kasih dan doa. Al-Qur’an disebut penyembuh dan rahmat bagi orang beriman (Al-Isra 17:82); para ulama memaknai <em>shifa</em> di sini terutama untuk hati dan jiwa.</div>\n  </section>\n\n  <section class=\"beat\">\n    <div class=\"kicker r\">Sejujurnya</div>\n    <h2 class=\"r\">Kita berbuat baik — <em class=\"warm\">tanpa menjanjikan</em> apa pun.</h2>\n    <p class=\"lead r\">Tidak ada dalil sahih bahwa membaca surah tertentu membuat persalinan mudah atau anak rupawan; otoritas fikih menyatakannya tanpa dasar (mis. fatwa IslamWeb no. 88373). Maka praktik ini dilakukan sebagai kebaikan dan pembiasaan, bukan jaminan hasil.</p>\n    <div class=\"chip-row r\"><span class=\"chip\">Disajikan dengan derajatnya</span></div>\n  </section>\n\n  <section class=\"beat\">\n    <div class=\"kicker r\">Dan satu hal lagi</div>\n    <h2 class=\"r\">Ini menumbuhkan <em class=\"cool\">kedekatan</em> — bukan menaikkan IQ.</h2>\n    <p class=\"lead r\">Bukti mendukung keakraban, pengenalan, dan ikatan — bukan kecerdasan yang lebih tinggi. Tujuannya kelekatan dengan ananda, bukan menjadikannya “lebih pintar”.</p>\n  </section>\n\n  <section class=\"beat\">\n    <div class=\"kicker r\">Caranya</div>\n    <h2 class=\"r\">Cukup suaramu, setiap hari.</h2>\n    <div class=\"cards\">\n      <div class=\"card r\"><span class=\"n\">01</span><p>Pada waktu yang sama setiap hari — konsistensi inilah yang membentuk memori, bukan intensitas sesaat.</p></div>\n      <div class=\"card r\"><span class=\"n\">02</span><p>Lantunkan, baca, atau bicara lembut ke arah perut. Cukup ponsel bila ingin memutar murottal; alat tidak wajib.</p></div>\n      <div class=\"card r\"><span class=\"n\">03</span><p>Cairan ketuban menghantar dan dapat menguatkan suara, jadi jaga volume tetap lembut dan jangan menempelkan speaker atau headphone langsung ke perut — suara dari ruangan saja sudah sampai padanya, dan tidak ada anjuran memutar audio keras langsung ke perut. <span class=\"faint\">Bila ragu soal volume yang aman, tanyakan ke dokter atau bidan.</span></p></div>\n    </div>\n  </section>\n\n  <section class=\"beat\">\n    <div class=\"kicker r\">Khazanah</div>\n    <h2 class=\"r\">Pendengaran — <em class=\"warm\">karunia yang Allah sebut lebih dulu</em>.</h2>\n    <div class=\"layer iman r\"><div class=\"l\">Khazanah · Iman</div>Ketika Allah menyebut karunia-Nya pada manusia, pendengaran disebut sebelum penglihatan: “…dan Dia menjadikan bagi kamu pendengaran, penglihatan, dan hati; sedikit sekali kamu bersyukur” (As-Sajdah 32:9; senada An-Nahl 16:78). Urutan ini selaras dengan kenyataan bahwa pendengaran janin berfungsi lebih dulu — maka menyiapkan lingkungan suara yang baik adalah cara merawat karunia yang pertama itu, dengan syukur.</div>\n    <p class=\"note r\">Disajikan sebagai kebaikan yang berdasar, bukan ritual berpahala khusus: yang kukuh adalah keutamaan tilawah dan suasana yang tenang — bukan tata cara tertentu yang ditetapkan. <span class=\"src-inline\">As-Sajdah 32:9 · An-Nahl 16:78</span><button class=\"tb-dlk\" data-d=\"q-sajdah-32-9\" type=\"button\" title=\"Buka kartu dalil\"><b>۞</b>dalil</button><button class=\"tb-dlk\" data-d=\"q-nahl-16-78\" type=\"button\" title=\"Buka kartu dalil\"><b>۞</b>dalil</button></p>\n  </section>\n\n  <section class=\"beat\">\n    <div class=\"kicker r\">Mulai malam ini</div>\n    <h2 class=\"r\">Pelan-pelan, dengan <em class=\"warm\">kasih</em>.</h2>\n    <p class=\"lead r\">Tak perlu sempurna. Kehadiran suaramu sudah berarti baginya.</p>\n    <details class=\"sources r\">\n      <summary>Lihat sumber &amp; verifikasi <svg class=\"cv\" viewBox=\"0 0 24 24\" width=\"16\" height=\"16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M6 9l6 6 6-6\"/></svg></summary>\n      <div class=\"body\">\n        <p><b>Sains.</b> DeCasper &amp; Fifer (1980), Science 208:1174–1176 · Partanen dkk. (2013), PLoS ONE 8(10):e78946 · Kisilevsky dkk. (2003), Psychol Sci 14:220–224 · Hepper &amp; Shahidullah (1994), PMC1061088 · Voegtline dkk. (2013), Infant Behav Dev 36:526–533.</p>\n        <p><b>Iman.</b> Al-Qur’an sebagai penyembuh dan rahmat: Al-Isra 17:82<button class=\"tb-dlk\" data-d=\"q-isra-17-82\" type=\"button\" title=\"Buka kartu dalil\"><b>۞</b>dalil</button> · tartil: Al-Muzzammil 73:4<button class=\"tb-dlk\" data-d=\"q-muzzammil-73-4\" type=\"button\" title=\"Buka kartu dalil\"><b>۞</b>dalil</button>. Catatan klaim surah-spesifik: tidak ada dalil khusus yang sahih — fatwa IslamWeb no. 88373.</p>\n        <p><b>Pendamping profesional.</b> dokter/bidan (keamanan suara) · adaptasi ke rutinitas Ibu.</p>\n      </div>\n    </details>\n    <div class=\"chip-row r\"><span class=\"chip confirm\">Konfirmasi dokter/bidan</span><span class=\"chip\">Adaptasi ke anak</span></div>\n  </section>\n\n  <div class=\"foot\">TARBIYAH · Modul T3-01 “Suara untuk Ananda” · Edisi cherry blossom. Setiap klaim disertai sumber pada titiknya; perbedaan pendapat ditandai apa adanya.</div>\n</main>\n\n<script>\n  const bar = document.getElementById(\"bar\");\n  addEventListener(\"scroll\", () => { const h = document.documentElement, m = h.scrollHeight - h.clientHeight; bar.style.width = (m > 0 ? h.scrollTop / m * 100 : 0) + \"%\"; }, { passive: true });\n\n  const io = new IntersectionObserver(es => es.forEach(e => { if (e.isIntersecting) { e.target.classList.add(\"in\"); io.unobserve(e.target); } }), { threshold: .14 });\n  document.querySelectorAll(\".r\").forEach((el, i) => { el.style.transitionDelay = (i % 4 * 0.06) + \"s\"; io.observe(el); });\n\n  document.querySelectorAll(\"[data-qa]\").forEach(qa => {\n    const btn = qa.querySelector(\"button\"), ans = qa.querySelector(\".ans\");\n    btn.addEventListener(\"click\", () => { const open = qa.classList.toggle(\"open\"); btn.setAttribute(\"aria-expanded\", open ? \"true\" : \"false\"); ans.style.maxHeight = open ? ans.scrollHeight + \"px\" : \"0px\"; });\n  });\n\n  const scrolly = document.getElementById(\"scrolly\"), cap = document.getElementById(\"cap\"), baby = document.getElementById(\"baby\");\n  const STEPS = [\n    \"Pendengaran ananda sudah aktif dan konsisten sejak sekitar minggu ke-28.\",\n    \"Suaramu paling jernih — dihantar dari dalam tubuhmu sendiri, bukan suara luar yang teredam. <span class='src'>Voegtline dkk. (2013)</span>\",\n    \"Ia tak sekadar mendengar; ia mengingat — jejaknya terdeteksi saat lahir. <span class='src'>DeCasper &amp; Fifer (1980); Partanen dkk. (2013)</span>\"\n  ];\n  let cur = -1;\n  function onScroll() {\n    const r = scrolly.getBoundingClientRect(), total = scrolly.offsetHeight - innerHeight;\n    let p = (-r.top) / total; p = Math.max(0, Math.min(1, p));\n    const step = p < .34 ? 0 : p < .68 ? 1 : 2;\n    if (step !== cur) { cur = step; cap.style.opacity = 0; setTimeout(() => { cap.innerHTML = STEPS[step]; cap.style.opacity = 1; }, 200); baby.classList.toggle(\"resp\", step === 2); }\n  }\n  addEventListener(\"scroll\", onScroll, { passive: true }); onScroll();\n\n  (function(){\n    var el=document.getElementById(\"audEl\"), btn=document.getElementById(\"audBtn\"),\n        path=document.getElementById(\"audPath\"), fill=document.getElementById(\"audFill\"),\n        bar=document.getElementById(\"audBar\"), time=document.getElementById(\"audTime\");\n    if(!el||!btn) return;\n    var PLAY=\"M8 5v14l11-7z\", PAUSE=\"M7 5h4v14H7zM13 5h4v14h-4z\";\n    function fmt(t){ if(!isFinite(t)||t<0) t=0; var m=Math.floor(t/60), s=Math.floor(t%60); return m+\":\"+(s<10?\"0\":\"\")+s; }\n    btn.addEventListener(\"click\", function(){ if(el.paused){ el.play().catch(function(){}); } else { el.pause(); } });\n    el.addEventListener(\"play\", function(){ path.setAttribute(\"d\",PAUSE); btn.setAttribute(\"aria-pressed\",\"true\"); btn.setAttribute(\"aria-label\",\"Jeda narasi\"); });\n    el.addEventListener(\"pause\", function(){ path.setAttribute(\"d\",PLAY); btn.setAttribute(\"aria-pressed\",\"false\"); btn.setAttribute(\"aria-label\",\"Putar narasi\"); });\n    el.addEventListener(\"timeupdate\", function(){ var d=el.duration||0; fill.style.width=(d? (el.currentTime/d*100):0)+\"%\"; time.textContent=fmt(d? (d-el.currentTime):0); });\n    el.addEventListener(\"loadedmetadata\", function(){ time.textContent=fmt(el.duration); });\n    el.addEventListener(\"ended\", function(){ path.setAttribute(\"d\",PLAY); fill.style.width=\"0%\"; btn.setAttribute(\"aria-pressed\",\"false\"); time.textContent=fmt(el.duration); });\n    bar.addEventListener(\"click\", function(e){ var r=bar.getBoundingClientRect(); var p=(e.clientX-r.left)/r.width; if(el.duration) el.currentTime=Math.max(0,Math.min(1,p))*el.duration; });\n  })();\n</script>\n\n<style>\n.tb-dlk{display:inline-flex;align-items:center;gap:.34em;margin:0 .18em;padding:.08em .6em .12em .5em;border:1px solid #E9B7CF;border-radius:999px;background:linear-gradient(180deg,#FFF9FC,#FBE3EF);color:#8A5E12;font-family:inherit;font-size:.76em;font-weight:700;letter-spacing:.01em;line-height:1.55;cursor:pointer;vertical-align:baseline;white-space:nowrap;box-shadow:0 1px 2px rgba(194,60,126,.10);transition:transform .12s ease,box-shadow .12s ease}\n.tb-dlk b{font-weight:800;color:#C23C7E;font-size:1.05em;line-height:1}\n.tb-dlk:hover{transform:translateY(-1px);box-shadow:0 3px 9px rgba(194,60,126,.20)}\n.tb-dlk:active{transform:translateY(0)}\n@media (prefers-reduced-motion:reduce){.tb-dlk{transition:none}.tb-dlk:hover{transform:none}}\n</style>\n<script>document.addEventListener(\"click\",function(e){var t=e.target,b=t&&t.closest?t.closest(\".tb-dlk\"):null;if(!b)return;e.preventDefault();var id=b.getAttribute(\"data-d\");try{if(parent&&parent.TB&&typeof parent.TB.openDalil===\"function\"){parent.TB.openDalil(id);return;}}catch(_){}try{parent.postMessage({tb:\"dalil\",id:id},\"*\");}catch(__){}},true);</script>\n</body>\n</html>\n"}